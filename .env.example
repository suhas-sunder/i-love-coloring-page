# Canonical public site URL used for metadata, robots, and sitemap output.
# Local development runs on localhost port 3005.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Public generated-media base URL.
# Use the public asset domain plus the uploaded coloring-pages prefix.
# Do not point this at the private S3 API endpoint.
# r2.dev is allowed only as a temporary Round 4H test route, not as the
# intended production media URL.
# The resolver safely handles trailing slashes, but omitting them is preferred.
NEXT_PUBLIC_COLORING_ASSET_BASE_URL=https://assets.example.com/coloring-pages

# Optional future Cloudflare R2 scripted-upload settings.
# These are not required for the current verification round. Real credential
# values must never be committed.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.example.com
CLOUDFLARE_R2_UPLOAD_PREFIX=coloring-pages
