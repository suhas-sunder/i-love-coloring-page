# Optional public overrides for metadata, robots, sitemap output, and local development.
# Production defaults to https://www.ilovecoloringpage.com when this is unset.
# Local development can override this with http://localhost:3005.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Optional public generated-media base URL override.
# Production defaults to https://assets.ilovecoloringpage.com/coloring-pages when unset.
# If overridden for production, use the final public asset domain plus /coloring-pages.
# Do not point this at the private S3 API endpoint.
# r2.dev is temporary/testing only, not the preferred production media URL.
# The resolver safely handles trailing slashes, but omitting them is preferred.
# Verify this domain before image sitemap or Open Graph image work.
NEXT_PUBLIC_COLORING_ASSET_BASE_URL=https://assets.example.com/coloring-pages

# Optional public contact email shown on Contact, Privacy, Terms, and disclosure pages.
# Production defaults to admin@ilovecoloringpage.com when unset.
# This value is public if set. Do not put private addresses here unless they are
# intended to be published.
NEXT_PUBLIC_CONTACT_EMAIL=admin@ilovecoloringpage.com

# Optional public site and policy wording values.
NEXT_PUBLIC_SITE_NAME=I Love Coloring Page
NEXT_PUBLIC_SITE_OWNER_NAME=
NEXT_PUBLIC_SITE_JURISDICTION=

# Privacy and Terms pages are practical drafts and still require owner/legal review
# before launch, live ads, or affiliate links.
