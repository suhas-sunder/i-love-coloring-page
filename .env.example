# Canonical public site URL used for metadata, robots, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public generated-media base URL.
# For the Round 4G Cloudflare R2 test upload, use the public custom-domain URL
# plus the uploaded test prefix. Do not point this at the private S3 API endpoint.
# r2.dev is not the intended production media URL.
# The resolver safely handles trailing slashes, but omitting them is preferred.
NEXT_PUBLIC_COLORING_ASSET_BASE_URL=https://assets.example.com/coloring/test-v1

# Optional future Cloudflare R2 scripted-upload settings.
# These are not required for Round 4G. The current workflow is manual upload from
# pipeline/r2-upload-test/coloring/test-v1, and real credential values must never
# be committed.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://assets.example.com
CLOUDFLARE_R2_UPLOAD_PREFIX=coloring/test-v1
