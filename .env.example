# Canonical public site URL used for metadata, robots, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production media should be served from object storage or a CDN.
# Example shape: https://cdn.example.com/coloring/round-3c-line-thick
# The resolver safely handles a trailing slash, but omitting it is preferred.
NEXT_PUBLIC_COLORING_ASSET_BASE_URL=

# Development-only local preview toggle. Keep this disabled in production.
NEXT_PUBLIC_COLORING_USE_LOCAL_ASSET_PROXY=0

# Development-only server-side proxy toggle. Keep this disabled in production.
# When enabled, the proxy serves only pipeline/production/full/assets/{svg,png,thumbs}.
COLORING_ENABLE_LOCAL_ASSET_PROXY=0
