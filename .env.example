# Canonical public site URL used for metadata, robots, and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production media should be served from object storage or a CDN.
# Example shape: https://cdn.example.com/coloring/round-3c-line-thick
# The resolver safely handles a trailing slash, but omitting it is preferred.
NEXT_PUBLIC_COLORING_ASSET_BASE_URL=

# Local media preview should use the same base URL contract.
# For example, serve pipeline/production/full/assets with a separate static file server
# and set NEXT_PUBLIC_COLORING_ASSET_BASE_URL=http://localhost:3010.
